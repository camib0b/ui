{
  "name": "@camib0b/ui",
  "version": "0.1.0",
  "description": "Shared design system for camilaescudero.cl and its tools.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camib0b/ui.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "preset.js",
    "preset.d.ts",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./preset": {
      "types": "./preset.d.ts",
      "require": "./preset.js",
      "default": "./preset.js"
    },
    "./ui.css": "./dist/ui.css",
    "./tokens.css": "./dist/tokens.css",
    "./theme-v4.css": "./dist/theme-v4.css",
    "./motion.css": "./dist/motion.css",
    "./header": {
      "types": "./dist/site-header.d.ts",
      "require": "./dist/site-header.js",
      "default": "./dist/site-header.js"
    },
    "./language": {
      "types": "./dist/language-context.d.ts",
      "require": "./dist/language-context.js",
      "default": "./dist/language-context.js"
    },
    "./drop-zone": {
      "types": "./dist/drop-zone.d.ts",
      "require": "./dist/drop-zone.js",
      "default": "./dist/drop-zone.js"
    },
    "./attention-pulse": {
      "types": "./dist/attention-pulse.d.ts",
      "require": "./dist/attention-pulse.js",
      "default": "./dist/attention-pulse.js"
    },
    "./curtain-reveal": {
      "types": "./dist/curtain-reveal.d.ts",
      "require": "./dist/curtain-reveal.js",
      "default": "./dist/curtain-reveal.js"
    },
    "./patterned-background": {
      "types": "./dist/patterned-background.d.ts",
      "require": "./dist/patterned-background.js",
      "default": "./dist/patterned-background.js"
    },
    "./reveal": {
      "types": "./dist/use-reveal-presence.d.ts",
      "require": "./dist/use-reveal-presence.js",
      "default": "./dist/use-reveal-presence.js"
    }
  },
  "sideEffects": [
    "./dist/ui.css",
    "./dist/tokens.css",
    "./dist/theme-v4.css",
    "./dist/motion.css"
  ],
  "scripts": {
    "build": "node scripts/build-css.cjs && tsc -p tsconfig.json",
    "test": "node scripts/build-css.cjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
